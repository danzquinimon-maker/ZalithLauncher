<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/background_game_menu">

    <ImageView
        android:id="@+id/settings_button"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/background_game_menu_gear"
        android:contentDescription="@string/in_game_settings_button"
        android:padding="@dimen/_6sdp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_game_menu_gear"
        android:tint="@color/accent"
        android:clickable="false"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/fps_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_toEndOf="@id/settings_button"
        android:visibility="gone"
        android:text="FPS: 114514"
        android:textColor="@color/primary_text"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/memory_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_toEndOf="@id/fps_text"
        android:visibility="gone"
        android:text="M: 0MB/0MB"
        android:textColor="@color/primary_text"
        tools:ignore="HardcodedText" />

</RelativeLayout>
